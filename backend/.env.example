# URL de conexão com a base PostgreSQL do Supabase. 
# Obtenha em: Dashboard -> Project Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL="postgresql://postgres.[SEU_PROJETO]:[SUA_SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres"

# JWT Secret para verificação de login do Supabase Auth no Backend.
# Obtenha em: Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET="seu_jwt_secret_do_supabase"

# URL pública do Supabase e Anon Key para inicializar o cliente JS no Frontend.
# Obtenha em: Dashboard -> Project Settings -> API -> Project API keys
SUPABASE_URL="https://[SEU_PROJETO].supabase.co"
SUPABASE_ANON_KEY="sua_anon_public_key_do_supabase"
